{
    "name": "ContiSent Dev Environment",
    "image": "mcr.microsoft.com/devcontainers/universal:2",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "enableNonRootDocker": "true",
            "moby": "true"
        }
    },
    "postCreateCommand": "npm install -g npm@latest && pip install --upgrade pip",
    "forwardPorts": [3000, 8000],
    "portsAttributes": {
        "3000": {
            "label": "Frontend UI",
            "onAutoForward": "notify"
        },
        "8000": {
            "label": "Backend API",
            "onAutoForward": "notify"
        }
    }
}
